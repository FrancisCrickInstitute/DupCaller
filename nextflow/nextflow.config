// Every parameter except the booleans, which DupCaller.nf declares with a
// type. Override on the command line (--name value), in a -params-file or a -c file.
params {
    // Tab-separated, with a header: sample_id, tumor_fastq_1, tumor_fastq_2,
    // normal_fastq_1, normal_fastq_2. The normal columns are not read when
    // normal_bam or tumor_only is set.
    sample_map = null
    outdir     = './results'
    normal_bam = null     // one aligned, indexed (.bai) normal BAM shared by every sample

    // Reference: either genome (hg38 or mm39, read from <genome_base>/<genome>/,
    // which bin/fetch_genome.sh fills) or your own reference FASTA. Either
    // way the .fai, the bwa-mem2 index and the DupCaller index (.ref.h5,
    // .tn.h5, .hp.h5, .str.h5, .dbs.h5) sit next to the FASTA, unless
    // skip_bwa_index / skip_index is false and the pipeline builds them.
    genome        = null
    genome_base   = null
    genome_strain = null  // mm39 only: strain of the germline VCF, e.g. C57BL_6NJ
    reference     = null
    repeat_tsv    = null  // PERF repeat table for DupCaller.py index; needed when skip_index = false

    // Each is bgzip-compressed (.gz) with its tabix index (.gz.tbi) next to
    // it. genome supplies germline_vcf and noise_mask unless they are set here.
    germline_vcf = null   // germline VCF with an AF field
    noise_mask   = null   // one noise mask BED, or a list of several
    target_bed   = null   // restrict calling to these regions
    indel_bed    = null   // indel-enhanced panel of normals
    gene_bed     = null   // columns chrom, start, end, GENE_exon: per-gene duplex coverage (dNdScv)

    // protocol (renanoseq, nanoseqv2, udseq, metacs) replaces barcode_pattern,
    // trim_template and trim_read. In a pattern N is a barcode base, X a
    // skipped base and B one barcode from barcode_list (one per line).
    protocol        = null
    barcode_pattern = 'NNNXXXX'
    barcode_list    = null
    trim_template   = 7   // ignore mutations within N bp of template ends
    trim_read       = 7   // ignore mutations within N bp of read ends

    regions            = null    // space-separated contigs; null = the genome's autosomes + chrX (hg38's without genome)
    max_af             = 1       // maximum tumour allele fraction to call (-maf); below 1 also masks positions with raw tumour depth < ceil(1/max_af)
    germline_af_cutoff = 0.001   // skip positions with germline AF above this
    min_n_depth        = 10      // minimum normal depth for a called variant
    mapq               = 40      // minimum mapping quality
    p_threshold        = null    // strand-independence filter (-pt); null = DupCaller.py's 0.05, 0 disables
    seed               = null    // null = DupCaller picks and logs a random seed

    // The image tag is the DupCaller version: release.yml reads it from this line.
    dupcaller_container = 'ghcr.io/alexandrovlab/dupcaller:1.2.12'

    threads    = 16       // CPUs for bwa-mem2, samtools sort and DupCaller.py call
    max_cpus   = 16
    max_memory = '128.GB'
    max_time   = '168.h'

    custom_config_version = 'master'
    custom_config_base    = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
}

includeConfig 'conf/base.config'

// nf-core's institutional profiles, which is where `crick` comes from. The
// config parser has no try/catch, so an unreachable base aborts the run:
// NXF_OFFLINE=true or a null custom_config_base skips the fetch.
includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ? "${params.custom_config_base}/nfcore_custom.config" : '/dev/null'

profiles {
    docker {
        docker.enabled      = true
        singularity.enabled = false
        docker.runOptions   = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    // Apple Silicon: every image is linux/amd64 only. Use with docker.
    arm  { docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64' }
    // Use with crick, which sets the executor, Singularity and the limits.
    nemo { includeConfig 'conf/compute/nemo.config' }
}

// Off because Nextflow's task monitor needs `ps`, which the images do not all have.
timeline { enabled = false }
report   { enabled = false }
trace    { enabled = false }
dag      { enabled = false }

manifest {
    name            = 'FrancisCrickInstitute/DupCaller'
    homePage        = 'https://github.com/FrancisCrickInstitute/DupCaller'
    description     = 'Somatic mutation calling from barcoded ecNGS data'
    mainScript      = 'DupCaller.nf'
    nextflowVersion = '!>=26.04.0'
    version         = '1.2.12'
}
