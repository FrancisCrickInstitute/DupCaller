// Each genome's core files, read in place where they live at the Crick: nothing listed
// here is copied. build_reference.nf derives what DupCaller adds to a genome (its index,
// the PERF repeat table, the bwa-mem2 index, a .fai if the FASTA has none) into
// <genome_base>/<genome>/, once; DupCaller.nf --genome reads both. Same shape as
// nf-core's igenomes.config, so another genome is one more block, here or in a -c file.
//
//   fasta         reference FASTA (required)
//   germline_vcf  bgzipped germline VCF with an AF field, .tbi beside it
//   noise_mask    list of bgzipped masks, each with a .tbi beside it
//   regions       contigs to call, space-separated
//   repeat_tsv    PERF repeat table; omitted, build_reference.nf generates it
params {
    genomes {
        // TODO: core Crick paths, not yet filled in. The lab's earlier runs used the GRCh38
        // no-alt analysis set, the GATK AF-only gnomAD VCF and the NanoSeq NOISE mask.
        hg38 {
            fasta        = null
            germline_vcf = null
            noise_mask   = []
            regions      = 'chr1 chr2 chr3 chr4 chr5 chr6 chr7 chr8 chr9 chr10 chr11 chr12 chr13 chr14 chr15 chr16 chr17 chr18 chr19 chr20 chr21 chr22 chrX'
        }
        mm39 {
            fasta        = null
            germline_vcf = null
            noise_mask   = []
            regions      = 'chr1 chr2 chr3 chr4 chr5 chr6 chr7 chr8 chr9 chr10 chr11 chr12 chr13 chr14 chr15 chr16 chr17 chr18 chr19 chrX'
        }
    }
}
