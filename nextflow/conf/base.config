// Sized for whole-genome duplex libraries (~65 GB fq.gz per read: trim ~3 h,
// markdup ~7 h).
process {
    // A closure: the limits must resolve when a task is submitted, so that a
    // max_* set in a profile, a -c file or on the command line is honoured.
    resourceLimits = { [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time] }
    // No task asks for more than 72 h, retries included: NEMO extends no job beyond that.

    cpus   = 1
    memory = 4.GB
    time   = 4.h

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    // build_reference.nf only. Unmeasured on hg38: the lab's working index build ran
    // in a 64 GB, 24 h job; the PERF scan has no measurement at all.
    withName: 'INDEX_REFERENCE' {
        memory = { 64.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withName: 'REPEATS' {
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
    withName: 'TRIM_BARCODES' {
        time = { 12.h * task.attempt }
    }
    // bwa-mem2 index needs ~28 bytes of RAM per reference base (~90 GB for GRCh38).
    withName: 'BWA_MEM2_INDEX' {
        memory = { new nextflow.util.MemoryUnit(28L * reference.size() + 2.GB.toBytes()) * task.attempt }
        time   = { 12.h * task.attempt }
    }
    // 32 GB for bwa-mem2 mem plus 1 GB per CPU for samtools sort beside it.
    // 48 h: on NEMO a 519 GB library took 23 h 58 min at 16 CPUs (Nov 2026).
    withName: 'BWA_MEM2_SORT' {
        cpus   = { params.threads }
        memory = { (32.GB + 1.GB * task.cpus) * task.attempt }
        time   = { [48.h * task.attempt, 72.h].min() }
    }
    // 48 h: on NEMO a 320-390 GB library took 21 h or more (Nov 2026).
    withName: 'MARK_DUPLICATES' {
        memory = { 64.GB * task.attempt }
        time   = { [48.h * task.attempt, 72.h].min() }
    }
    // DupCaller gives each CPU one fixed share of the genome, and time grows faster
    // than BAM size: at 16 CPUs, 48-92 GB took 5-9 h, 216 GB about 38 h and 285 GB
    // about 60 h (NEMO, Nov 2026). One CPU per 5 GB of BAM, from threads up to 96,
    // keeps a whole genome inside 72 h. Memory peaks in the final mutation-rate step:
    // 0.4-0.85 GB per GB of BAM (a 443 GB BAM at 90 CPUs passed 356 GB), so 8 GB per CPU.
    withName: 'CALL_VARIANTS' {
        cpus   = { Math.min(96, Math.max(params.threads as int, Math.ceil(tumor_bam.size() / 5e9) as int)) }
        memory = { 8.GB * task.cpus * task.attempt }
        time   = { 72.h }
    }
    // 8 GB ran out of memory on 4 of 6 UDseq whole-genome libraries (Nov 2026); 16 GB passed.
    withName: 'ESTIMATE_BURDEN' {
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
}
