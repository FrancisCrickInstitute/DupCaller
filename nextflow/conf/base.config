// Sized for whole-genome duplex libraries (~65 GB fq.gz per read: trim ~3 h,
// markdup ~7 h).
process {
    // A closure: the limits must resolve when a task is submitted, so that a
    // max_* set in a profile, a -c file or on the command line is honoured.
    resourceLimits = { [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time] }

    cpus   = 1
    memory = 4.GB
    time   = 4.h

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    withName: 'INDEX_REFERENCE' {
        memory = 8.GB
    }
    withName: 'TRIM_BARCODES' {
        time = { 12.h * task.attempt }
    }
    // bwa-mem2 index needs ~28 bytes of RAM per reference base (~90 GB for GRCh38).
    withName: 'BWA_MEM2_INDEX' {
        memory = { new nextflow.util.MemoryUnit(28L * reference.size() + 2.GB.toBytes()) * task.attempt }
        time   = { 12.h * task.attempt }
    }
    // 32 GB for bwa-mem2 mem plus 1 GB per CPU for samtools sort beside it.
    withName: 'BWA_MEM2_SORT' {
        cpus   = { params.threads }
        memory = { (32.GB + 1.GB * task.cpus) * task.attempt }
        time   = { 24.h * task.attempt }
    }
    withName: 'MARK_DUPLICATES' {
        memory = { 64.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }
    // 6 GB per CPU: whole-genome call peaks at ~2 GB per worker.
    withName: 'CALL_VARIANTS' {
        cpus   = { params.threads }
        memory = { 6.GB * task.cpus * task.attempt }
        time   = { 96.h * task.attempt }
    }
    withName: 'ESTIMATE_BURDEN' {
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }
}
